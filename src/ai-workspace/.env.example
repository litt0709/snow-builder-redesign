# Bật/tắt ghi nhận 4 file JSON audit cho mỗi phiên làm việc (1 = bật, 0 = tắt)
IS_AUDIT=1

# Chính sách cổng phê duyệt mặc định: balanced (chỉ hỏi HITL khi có rủi ro cao/câu hỏi mở) | strict (hỏi mọi gate)
SPEEDY_GATE_POLICY=balanced

# Nguồn Git repository dùng cho lệnh /update-speedy (mặc định đã tự lưu ở .speedy/config/source.local.json khi cài 1 lệnh)
SPEEDY_SOURCE_URL=https://github.com/litt0709/snow-builder-redesign.git
